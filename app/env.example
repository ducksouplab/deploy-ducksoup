# ---------------------------------------
# options that may evolve more frequently
# ---------------------------------------
# what origins (serving experiments) are allowed to use DuckSoup
DUCKSOUP_ALLOWED_WS_ORIGINS=https://ducksoup.yourdomain.com,https://socialxp.yourdomain.com,http://localhost:8100,http://localhost:8180

# set to true to use nvcodec (needs correctly set up NVIDIA GPU)
DUCKSOUP_NVCODEC=true
DUCKSOUP_NVCUDA=true

# DuckSoup runtime options
DUCKSOUP_JITTER_BUFFER=250
DUCKSOUP_GENERATE_PLOTS=true
DUCKSOUP_GENERATE_TWCC=true
DUCKSOUP_GCC=true
DUCKSOUP_GST_TRACKING=false
DUCKSOUP_LOG_STDOUT=true
DUCKSOUP_LOG_FILE=log/ducksoup.log
DUCKSOUP_LOG_LEVEL=3
DUCKSOUP_INTERCEPT_GST_LOGS=false
DUCKSOUP_FORCE_OVERLAY=false
DUCKSOUP_CONTAINER_STDOUT_FILE=log/ducksoup.stdout.log
DUCKSOUP_CONTAINER_STDERR_FILE=log/ducksoup.stderr.log
GST_DEBUG=2
GST_DEBUG_FILE=log/gst.log
#GST_TRACERS=stats;rusage
#PION_LOG_TRACE=turn
#PION_LOG_TRACE=all
#PION_LOG_TRACE=pc,ice

# use the following STUN servers (or set to false) for ICE candidates gathering
#DUCKSOUP_STUN_SERVER_URLS=false
DUCKSOUP_STUN_SERVER_URLS=stun:stun.l.google.com:19302
#DUCKSOUP_STUN_SERVER_URLS=stun:stun.l.google.com:19302,stun:stun3.l.google.com:19302,stun:stun1.l.google.com:19302,stun:stun2.l.google.com:19302

# oTree experiment runtime options (how to use DuckSoup)
OTREE_DUCKSOUP_REQUEST_GPU=true
OTREE_DUCKSOUP_FRAMERATE=25
OTREE_DUCKSOUP_WIDTH=800
OTREE_DUCKSOUP_HEIGHT=600
OTREE_DUCKSOUP_FORMAT=H264
OTREE_PRODUCTION=1

# -----------------------------------------------
# more stable configuration (linking and secrets)
# -----------------------------------------------

# main container user
DOCKER_UNAME=deploy
DOCKER_UID=1003
DOCKER_GID=1003

# used by "ducksoup" service
DUCKSOUP_PORT=8100
DUCKSOUP_WEB_PREFIX=
DUCKSOUP_TEST_LOGIN=admin
DUCKSOUP_TEST_PASSWORD=change_me

## Use DUCKSOUP_PUBLIC_IP without STUN as an ICE candidate
DUCKSOUP_EXPLICIT_HOST_CANDIDATE=true

## Needed either if STUN discovery is not availble or if DuckSoup TURN embedded server is enabled
DUCKSOUP_PUBLIC_IP=change_me

# embedded TURN server, leave empty to disable
DUCKSOUP_TURN_ADDRESS=ducksoup.yourdomain.com
DUCKSOUP_TURN_PORT=1194

# used by "db" service
POSTGRES_USER=experiment
POSTGRES_PASSWORD=change_me

# used by "experiment" service
OTREE_PORT=8180
OTREE_ADMIN_PASSWORD=change_me
OTREE_REST_KEY=change_me
# connection to other services
OTREE_DATABASE_URL="postgres://experiment:change_me@db/experiment"
OTREE_DUCKSOUP_URL=https://ducksoup.yourdomain.com
OTREE_DUCKSOUP_FRONTEND_VERSION=latest
OTREE_BASE_URL=https://socialxp.yourdomain.com

# used by "mastok" service
MASTOK_PORT=8190
MASTOK_ORIGIN=https://socialxp.yourdomain.com
MASTOK_WEB_PREFIX=/mastok
MASTOK_LOGIN=admin
MASTOK_PASSWORD=change_me
# disable default features if needed
#MASTOK_DISABLE_LIVE_REDIRECT=true
# connection to other services
MASTOK_DATABASE_URL="postgres://experiment:change_me@db/mastok"
MASTOK_OTREE_PUBLIC_URL=https://socialxp.yourdomain.com
MASTOK_OTREE_API_URL=http://experiment:8000
MASTOK_OTREE_API_KEY=change_me

# used by grafana
GF_PORT=3000
GRAFANA_PORT=3000
GF_PATH=https://ducksoup.yourdomain.com/grafana
GF_PASSWORD=change_me
